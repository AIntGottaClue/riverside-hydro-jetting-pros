---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { guides } from '../../data/pages';
import { u } from '../../lib/utils';
const title = 'Hydro Jetting Guides | Riverside Hydro Jetting Pros';
const description = 'Plain guides on how hydro jetting works and how it compares with snaking for drain and sewer lines in Riverside, Ohio.';
---
<Base title={title} description={description} path="/guides/" crumbs={[{ name: 'Guides', path: '/guides/' }]}>
  <Hero headline="Hydro Jetting Guides in Riverside, OH" intro="Short guides to help you ask the right questions before any drain cleaning." location="Guides" crumbs={[{ href: '/guides/', label: 'Guides' }]} />
  <section class="content-section"><div class="content-inner">
    <div class="card-grid">
      {guides.map((g, i) => <article class="card"><p class="eyebrow">Guide {String(i + 1).padStart(2, '0')}</p><h3><a href={u(`/guides/${g.slug}/`)}>{g.name}</a></h3><p>{g.blurb}</p></article>)}
    </div>
  </div></section>
</Base>
