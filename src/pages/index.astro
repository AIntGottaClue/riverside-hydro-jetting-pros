---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { C, services, guides } from '../data/pages';
import { neighborhoods } from '../data/neighborhoods';
import { faqSchema } from '../lib/seo';
import { business } from '../lib/site';
import { u } from '../lib/utils';
const home = C['/'];
const [s1, s2, s3, s4] = home.sections;
const faqs = home.faqs;
const steps = [
  { t: 'Describe the drain problem', d: 'Note which fixtures are slow, whether sewage has backed up and if a prior cleaning helped.' },
  { t: 'Check the line', d: 'A qualified professional can locate the obstruction and assess whether the pipe can handle jetting.' },
  { t: 'Choose the work that fits', d: 'Cleaning may help with buildup. Roots in a broken joint or a collapsed section may also need repair.' },
];
const tiles = [
  { big: String(services.length), small: 'Drain problems covered' },
  { big: String(neighborhoods.length), small: 'Local area pages' },
  { big: 'Call', small: 'To confirm availability' },
];
---
<Base title={home.title} description={home.desc} path="/" extraSchema={[faqSchema(faqs)]}>
  <Hero headline={home.h1} intro={home.intro} location="Homepage" tiles={tiles} />
  <section class="content-section"><div class="content-inner">
    <p class="eyebrow">Drain problems</p>
    <div class="section-head"><h2 class="section-title">{s1.h}</h2><p class="section-intro">{s1.ps[0]}</p></div>
    <div class="card-grid">
      {services.map((s, i) => import.meta.env.BASE_URL === '/' ? <article class="card"><span class="card-icon" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><p class="eyebrow">Service {String(i + 1).padStart(2, '0')}</p><h3><a href={u(`/services/${s.slug}/`)}>{s.name}</a></h3><p>{s.blurb}</p></article> : <a class="card service-card-link" href={u(`/services/${s.slug}/`)}><span class="card-icon" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><p class="eyebrow">Service {String(i + 1).padStart(2, '0')}</p><h3>{s.name}</h3><p>{s.blurb}</p></a>)}
      <article class="card card-spec"><p class="eyebrow">Method guides</p><h3>Jetting and snaking</h3><p>Two short guides on how the methods work and how they compare.</p><ul class="check-list">{guides.map((g) => <li><a href={u(`/guides/${g.slug}/`)}>{g.name}</a></li>)}</ul></article>
    </div>
  </div></section>
  <section class="dark-band"><div class="content-inner dark-grid">
    <div>
      <p class="eyebrow eyebrow-light">Local area pages</p>
      <h2 class="section-title section-title-light">{s3.h}</h2>
      <p class="band-text">Local history helps frame questions. It does not confirm a pipe problem or service coverage.</p>
      <div class="pill-grid pill-grid-dark">{neighborhoods.map((n) => <a class="pill" href={u(`/neighborhood/${n.slug}/`)}>{n.name}</a>)}</div>
    </div>
    <aside class="dispatch-card"><p class="eyebrow">Phone line</p><h3>Call to confirm availability</h3><p>Availability depends on the address and the work requested. A request is not an appointment.</p><a class="button-dark" href={business.phoneHref}>Call {business.phoneDisplay}</a></aside>
  </div></section>
  <section class="content-section"><div class="content-inner">
    <p class="eyebrow">Before you book</p>
    <h2 class="section-title">{s2.h}</h2>
    {s2.ps.map((p) => <p class="section-intro" style="margin-bottom:14px" set:html={p} />)}
    <h2 class="section-title" style="margin-top:56px">{s4.h}</h2>
    {s4.ps.map((p) => <p class="section-intro" style="margin-bottom:14px" set:html={p} />)}
    <div class="card-grid card-grid-3" style="margin-top:36px">{steps.map((s, i) => <article class="card"><p class="eyebrow">Step {i + 1}</p><h3>{s.t}</h3><p>{s.d}</p></article>)}</div>
  </div></section>
  <section class="content-section content-section-alt"><div class="content-inner">
    <p class="eyebrow">Questions</p>
    <h2 class="section-title">Questions worth asking before hydro jetting.</h2>
    <div class="content-list">{faqs.map((f) => <article class="faq-row"><h3>{f.q}</h3><p>{f.a}</p></article>)}</div>
  </div></section>
<section class="nh-body"><div class="nh-inner"><p set:html={`For drain problems, read <a href="/guides/how-hydro-jetting-works/">how hydro jetting works</a>, <a href="/services/recurring-clogs-and-slow-drains/">recurring clogs</a>, <a href="/services/severe-grease-and-sludge/">grease and sludge</a>, <a href="/services/tree-root-intrusions/">tree roots</a> and <a href="/services/preventative-maintenance/">Preventative hydro jetting</a>.`.replace(/href="(\/[^"]*)"/g, (_m, h) => 'href="' + u(h) + '"')} /></div></section>
</Base>

<style>.service-card-link{display:block;color:inherit;text-decoration:none;cursor:pointer}.service-card-link:hover h3{text-decoration:underline}.service-card-link:focus-visible{outline:3px solid #f2690d;outline-offset:4px}</style>
