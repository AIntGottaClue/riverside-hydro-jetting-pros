---
import { business } from '../lib/site';
const { title = 'Ready to describe the drain problem?', text = 'Call and say which fixtures are affected and whether hydro jetting may suit the line.' } = Astro.props;
---
<section class="callout"><div class="callout-inner">
  <div><h2>{title}</h2><p>{text}</p></div>
  <a class="button-primary" href={business.phoneHref}>Call {business.phoneDisplay}</a>
</div></section>
